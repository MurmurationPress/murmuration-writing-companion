{
  "name": "murmuration-writing-companion",
  "version": "0.18.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-plugin.mjs",
    "test": "tsc -p tsconfig.tests.json --noEmit --skipLibCheck && node scripts/run-tests.mjs && node --test scripts/tests/build-tools.test.mjs scripts/tests/interaction-capture.test.mjs",
    "benchmark:performance": "node scripts/benchmark-performance.mjs",
    "test:build": "node --test scripts/tests/build-tools.test.mjs",
    "test:watch": "node scripts/run-tests.mjs --watch",
    "build": "tsc -noEmit -skipLibCheck && node scripts/build-plugin.mjs",
    "bundle:report": "node scripts/report-bundle.mjs",
    "bundle:analyze": "tsc -noEmit -skipLibCheck && node scripts/build-plugin.mjs --analyze",
    "example:archive": "node scripts/build-example-vault.mjs",
    "release:check": "node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.23.0",
    "obsidian": "latest",
    "typescript": "^5.0.0"
  }
}
